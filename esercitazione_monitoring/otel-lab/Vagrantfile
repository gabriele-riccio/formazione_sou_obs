Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.hostname = "otel-lab"

  # Rete privata host-only: raggiungibile via 192.168.56.14 quando il
  # driver VirtualBox host-only e' attivo (oggi rotto: serve sblocco IT).
  config.vm.network "private_network", ip: "192.168.56.14"

  # Forward NAT: strada di ripiego, sempre funzionante via 127.0.0.1 sul Mac.
  # host_ip fissa il forward su IPv4 loopback.
  config.vm.network "forwarded_port", guest: 3000, host: 3000, host_ip: "127.0.0.1"
  config.vm.network "forwarded_port", guest: 9090, host: 9090, host_ip: "127.0.0.1"
  config.vm.network "forwarded_port", guest: 5000, host: 5000, host_ip: "127.0.0.1"

  config.vm.provider "virtualbox" do |vb|
    vb.name = "otel-lab"
    vb.memory = 4096
    vb.cpus = 2
  end

  config.vm.provision "shell", inline: <<-SHELL
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y podman python3-pip
    pip3 install --break-system-packages podman-compose
    # I servizi utente (podman rootless) restano vivi tra una sessione ssh e l'altra
    loginctl enable-linger vagrant
    podman --version
    podman-compose --version
  SHELL
end